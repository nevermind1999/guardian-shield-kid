<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- O papel de parede real é desenhado pelo próprio sistema atrás desta janela
         (tema AppTheme.Launcher com windowShowWallpaper=true). -->

    <!-- Vídeo de fundo animado (opcional): só existe/aparece quando o usuário escolhe um
         em "Personalizar". Fica escondido (GONE) por padrão pra não gastar recurso à toa;
         só é criado/tocado enquanto a Home está em primeiro plano. -->
    <TextureView
        android:id="@+id/videoWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Escurece um pouco o que estiver atrás (wallpaper estático ou vídeo) pra manter
         o texto legível. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#3A000000" />

    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOPO: engrenagem de configurações + paleta de personalização -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:padding="12dp">

            <ImageButton
                android:id="@+id/paletteButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_app_icon"
                android:src="@android:drawable/ic_menu_gallery"
                android:tint="#FFFFFF"
                android:contentDescription="Personalizar tela inicial" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_app_icon"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="#FFFFFF"
                android:contentDescription="Configurações do GuardianShield" />
        </LinearLayout>

        <!-- RELÓGIO: arrastar pra cima também abre a gaveta de apps -->
        <LinearLayout
            android:id="@+id/clockContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="20dp">

            <TextView
                android:id="@+id/clockText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#CCFFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- STATUS: bateria + tempo restante + pedir tempo extra -->
        <LinearLayout
            android:id="@+id/statusPill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_status_pill"
            android:padding="14dp">

            <TextView
                android:id="@+id/batteryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/remainingTimeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/requestTimeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:text="Tempo extra"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:background="@drawable/bg_button_primary"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp" />
        </LinearLayout>

        <!-- TAREFAS DE HOJE: só aparece se o pai cadastrou alguma tarefa no app dele -->
        <LinearLayout
            android:id="@+id/tasksSectionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="6dp"
                android:text="Tarefas de hoje"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tasksRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:clipToPadding="false" />
        </LinearLayout>

        <!-- GRID DA TELA INICIAL: quantos apps o usuário quiser fixar aqui, com o
             número de colunas que ele escolher em "Personalizar" -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/homeGridRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp" />

        <TextView
            android:id="@+id/emptyHomeHint"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="32dp"
            android:text="Toque e segure um app na gaveta para fixar aqui na tela inicial"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- ALÇA DA GAVETA: toque ou arraste pra cima pra abrir. O chevron balança
             sozinho (ver setupDrawerHandleBounce em LauncherHomeActivity) só pra
             sugerir o gesto, igual protótipo — a barra continua sendo o toque/arraste. -->
        <LinearLayout
            android:id="@+id/drawerHandle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/drawerHandleChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginBottom="2dp"
                android:src="@android:drawable/arrow_up_float"
                android:tint="#99FFFFFF"
                android:contentDescription="@null" />

            <View
                android:layout_width="44dp"
                android:layout_height="5dp"
                android:background="@drawable/bg_status_pill" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
