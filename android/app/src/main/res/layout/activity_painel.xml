<?xml version="1.0" encoding="utf-8"?>
<!-- Painel do GuardianShield no celular do filho (nativo; substitui a antiga tela em
     React/WebView). Pareamento, checklist do que falta configurar, tempo restante e
     pedido de tempo extra — ver PainelActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/painelScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/painelFundo"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/painelConteudo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="28dp">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/painelLogo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:text="🛡️"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GuardianShield"
                    android:textColor="@color/painelTexto"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/painelSubtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Celular protegido"
                    android:textColor="@color/painelTextoSuave"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/painelStatusSync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_painel_input"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:textColor="@color/painelTextoSuave"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Aviso de atualização disponível -->
        <LinearLayout
            android:id="@+id/painelAtualizacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_button_primary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nova versão disponível"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/painelAtualizacaoNotas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:textColor="#E6FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/painelAtualizarBotao"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_painel_button_ghost"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="Atualizar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/painelAtualizacaoFechar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Dispensar"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- PAREAMENTO (só quando ainda não pareado) -->
        <LinearLayout
            android:id="@+id/painelPareamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_painel_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp"
            android:visibility="gone">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:text="🔗"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Conectar ao celular dos pais"
                android:textColor="@color/painelTexto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="No app dos pais, toque em “Gerar código” e digite aqui os 4 números que aparecerem."
                android:textColor="@color/painelTextoSuave"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_painel_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="18dp"
                android:paddingRight="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GS-"
                    android:textColor="@color/painelTextoSuave"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/painelCodigo"
                    android:layout_width="120dp"
                    android:layout_height="64dp"
                    android:background="@null"
                    android:hint="0000"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:letterSpacing="0.15"
                    android:maxLength="4"
                    android:textColor="@color/painelTexto"
                    android:textColorHint="#57534E"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/painelPareamentoErro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/painelAlerta"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/painelParearBotao"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_primary"
                android:enabled="false"
                android:text="Conectar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TEMPO (só quando pareado) -->
        <LinearLayout
            android:id="@+id/painelTempo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_painel_card"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/painelTempoRotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="TEMPO RESTANTE HOJE"
                android:textColor="@color/painelTextoSuave"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/painelTempoValor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/painelTexto"
                android:textSize="44sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/painelTempoBarra"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="1000"
                android:progressBackgroundTint="#292524" />

            <TextView
                android:id="@+id/painelTempoDetalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/painelTextoSuave"
                android:textSize="13sp" />

            <Button
                android:id="@+id/painelPedirTempoBotao"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_primary"
                android:text="Pedir mais tempo"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CHECKLIST DE CONFIGURAÇÃO -->
        <LinearLayout
            android:id="@+id/painelChecklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_painel_card"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="18dp"
            android:paddingRight="18dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Proteção do aparelho"
                    android:textColor="@color/painelTexto"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/painelChecklistResumo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/painelTextoSuave"
                    android:textSize="13sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/painelChecklistBarra"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:progressBackgroundTint="#292524" />

            <LinearLayout
                android:id="@+id/painelChecklistItens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <TextView
            android:id="@+id/painelRodape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="#57534E"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
