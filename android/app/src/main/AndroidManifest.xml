<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- UpdaterModule: instalar o APK de atualização baixado via DownloadManager
         (não é uma permissão perigosa em tempo de execução — o usuário concede uma
         vez em Configurações se ainda não tiver permitido "instalar apps desconhecidos"
         pra este app; ver promptInstallDownloadedUpdate em MainActivity.java). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Foto de comprovação das tarefas diárias (LauncherHomeActivity): usa TakePicture(),
         que delega pro app de câmera do sistema via intent — NÃO precisa da permissão
         CAMERA (essa é só pra quem acessa a API de câmera diretamente). Declará-la sem
         implementar o fluxo de permissão em tempo de execução quebraria a captura. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Tela inicial (Home) nativa em Kotlin — substitui o launcher original do aparelho -->
        <activity
            android:name=".LauncherHomeActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme.Launcher"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Gaveta de apps nativa em Kotlin, aberta a partir da Home -->
        <activity
            android:name=".LauncherDrawerActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:exported="false" />

        <!-- Simulação de recorte do vídeo de fundo: mostra o vídeo tocando de verdade e
             deixa o usuário belisco/arrastar pra escolher zoom e posição antes de aplicar -->
        <activity
            android:name=".VideoCropActivity"
            android:theme="@style/AppTheme.NoActionBar"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- 1. ACCESSIBILITY SERVICE: Interceptação e Bloqueio de Apps -->
        <service
            android:name=".services.ParentalAccessibilityService"
            android:label="GuardianShield Core Protection"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 2. LOCAL VPN SERVICE: Filtro de Conteúdo Web e DNS -->
        <service
            android:name=".services.VpnFilterService"
            android:label="GuardianShield Web Protection"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- 3. DEVICE ADMIN RECEIVER: Proteção Anti-Desinstalação -->
        <receiver
            android:name=".receivers.DeviceAdminModule"
            android:label="GuardianShield Device Admin"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLE_REQUESTED" />
                <action android:name="android.app.action.DEVICE_ADMIN_DISABLED" />
            </intent-filter>
        </receiver>

        <!-- 4. LOCK OVERLAY SERVICE: Janela de Bloqueio em Tela Cheia -->
        <service
            android:name=".services.LockOverlayService"
            android:exported="false" />

    </application>

</manifest>
